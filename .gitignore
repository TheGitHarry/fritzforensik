__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.coverage
/tmp/

# Abzüge NIE einchecken — enthalten echte Forensikdaten.
# fritzexport legt pro Lauf ein Verzeichnis mit Zeitstempel-Suffix an.
# Nur im Wurzelverzeichnis (führender /): ohne den Anker verschluckt "export/"
# auch tests/export/ — eine neue Testdatei wäre dort stillschweigend nie
# eingecheckt worden.
/export/
export_*/

# Erzeugte Reports NIE einchecken — enthalten ebenfalls echte Forensikdaten.
*.report.html
report.html
reports/

# Referenzmaterial (PoC, fremder Parser, Testkopien) — NICHT ausliefern
_material/

# Node — nur Testwerkzeug (jsdom für den Filtertest).
# package.json und package-lock.json sind bewusst EINGECHECKT: sie sind die
# einzige Stelle, an der steht, dass der Filtertest jsdom braucht. Ohne sie
# skippt tests/report/test_filter.py in fremden Klonen still — grüner Lauf
# ohne geprüfte Filterlogik. Nur die Installation bleibt draußen.
node_modules/

# PyInstaller-Build-Artefakte
build/
dist/
*.spec
_MEI*
